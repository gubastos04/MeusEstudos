{
  "name": "meus-estudos",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de estudos praticos de programacao baseada na grade de ADS.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:provider": "node scripts/db-provider.mjs",
    "db:conferir": "node scripts/db-provider.mjs --conferir",
    "db:push": "prisma db push",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "deploy:preparar": "node scripts/db-provider.mjs postgresql && prisma generate && node scripts/db-provider.mjs --conferir",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "npm install && prisma generate && prisma db push && npm run content:sync && npm run db:seed",
    "content:sync": "tsx scripts/sync-content.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-sql": "^6.8.0",
    "@prisma/client": "^6.16.1",
    "@uiw/react-codemirror": "^4.23.14",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prisma": "^6.16.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.11"
  }
}
