# -----------------------------------------------------------------------------
# Copie para .env e ajuste. O arquivo .env nunca vai para o Git.
# -----------------------------------------------------------------------------

# Banco -----------------------------------------------------------------------
# O Prisma le SOMENTE DATABASE_URL. Mesmo nome nos dois ambientes, valor
# diferente: o SQLite local aqui, a string do PostgreSQL nas variaveis de
# ambiente do provedor de deploy. Nao existe variavel separada para producao.
# O caminho do SQLite e relativo a pasta prisma/:
DATABASE_URL="file:./dev.db"
# Producao (PostgreSQL - Neon, Supabase ou equivalente). Antes do deploy rode:
#   npm run db:provider postgresql
# DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Seguranca -------------------------------------------------------------------
# Assina cookies de sessao e criptografa a chave de IA de cada usuario.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar este valor invalida todas as sessoes e torna as chaves de IA salvas ilegiveis.
APP_SECRET="troque-este-valor-em-qualquer-ambiente-real-com-pelo-menos-32-chars"

# Origem publica da aplicacao. Usada na verificacao de CSRF (checagem de Origin).
# Em dev pode ficar vazio: localhost e aceito automaticamente.
APP_URL="http://localhost:3000"

# Email (recuperacao de senha) ------------------------------------------------
# A plataforma envia um unico email: o link de redefinicao de senha.
# Transporte: auto (padrao), console ou http.
#   auto    -> usa http quando MAIL_HTTP_URL existe; fora de producao, console
#   console -> escreve o email no log do servidor (desenvolvimento)
#   http    -> POST {from, to, subject, text} no provedor configurado abaixo
MAIL_TRANSPORTE="auto"
# Exemplo com Resend: https://api.resend.com/emails
MAIL_HTTP_URL=""
MAIL_HTTP_TOKEN=""
MAIL_FROM=""

# IA (opcional) ---------------------------------------------------------------
# Sem chave a aplicacao funciona normalmente: os botoes de IA continuam
# visiveis e explicam que a IA nao esta configurada. Nenhuma chamada e feita.
# A chave e usada SOMENTE no servidor e nunca chega ao navegador.
ANTHROPIC_API_KEY=""
IA_MODELO="claude-sonnet-5"
IA_LIMITE_DIARIO="40"
# Timeout de cada chamada, em milissegundos.
IA_TIMEOUT_MS="45000"
# Teto de tokens de saida por chamada (controle de custo).
IA_MAX_TOKENS="1200"

# Execucao de codigo ----------------------------------------------------------
# Exercicios de Python rodam no navegador com Pyodide, baixado sob demanda e
# somente apos confirmacao da pessoa. Troque a URL para servir o runtime do seu
# proprio dominio (evita depender de CDN e funciona em rede restrita).
NEXT_PUBLIC_PYODIDE_URL="https://cdn.jsdelivr.net/pyodide/v0.27.2/full/"

# Produto ---------------------------------------------------------------------
# Fuso usado para fechar o "dia" das metricas de atividade.
APP_TIMEZONE="America/Sao_Paulo"
# Defina como "false" para fechar novos cadastros (instancia pessoal).
PERMITIR_CADASTRO="true"
